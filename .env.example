# Telegram Bot Configuration
# Obtain your BOT_TOKEN from https://t.me/BotFather
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Webhook Secret Token (recommended by Telegram for security)
# Can be any random alphanumeric string (1-256 characters)
TELEGRAM_SECRET_TOKEN=my_super_secret_webhook_token_123

# Public URL of your deployed Vercel project (e.g. https://my-bot.vercel.app)
# Used for automatic /api/setup webhook registration
APP_URL=https://your-bot-domain.vercel.app

# Database Storage: Upstash Redis (Recommended for Vercel Serverless)
# Create a free database at https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxxxxx=

# Alternatively, if you use Vercel KV integration, it sets these automatically:
# KV_REST_API_URL=https://xxxx.upstash.io
# KV_REST_API_TOKEN=AXxxxxxxx=

# Bot Default Settings
DEFAULT_COOLDOWN_SECONDS=60
DEFAULT_CHUNK_SIZE=5
DEFAULT_PERMISSIONS=everyone
