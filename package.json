{
  "name": "zazyvala-bot-vercel",
  "version": "2.0.0",
  "description": "High-performance Telegram Tag/Mention bot (Zazyvala) optimized for Vercel Serverless limits",
  "main": "dist/api/webhook.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/dev-server.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "telegram",
    "bot",
    "zazyvala",
    "tag-all",
    "vercel",
    "serverless",
    "upstash",
    "redis"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "dependencies": {
    "@upstash/redis": "^1.34.3",
    "@vercel/functions": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@vercel/node": "^17.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
